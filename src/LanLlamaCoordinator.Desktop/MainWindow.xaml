<Window x:Class="LanLlamaCoordinator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Llama Coordinator" Height="650" Width="1050" MinHeight="500" MinWidth="800"
        Background="#F3F5F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="LAN Llama Coordinator" FontSize="26" FontWeight="Bold" Foreground="#182230" />
                <TextBlock Text="Yerel ağdaki worker cihazlarını yönetin" Margin="0,4,0,0" Foreground="#667085" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="White" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kayıtlı cihaz:" Foreground="#667085" />
                    <TextBlock Text="{Binding DeviceCount}" Margin="6,0,0,0" FontWeight="Bold" Foreground="#182230" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Cihaz adı" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Cihaz türü" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedDeviceType}" Height="34" Padding="6" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Bağlantı" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding NetworkTypes}" SelectedItem="{Binding SelectedNetworkType}" Height="34" Padding="6" />
                </StackPanel>
                <Button Grid.Column="3" Content="+ Cihaz ekle" Command="{Binding AddDeviceCommand}" Height="34" Padding="14,0" VerticalAlignment="Bottom" Background="#175CD3" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0" RowHeight="44" ColumnHeaderHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cihaz" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="*" />
                <DataGridTextColumn Header="Bağlantı" Binding="{Binding Network}" Width="*" />
                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*" />
                <DataGridCheckBoxColumn Header="Güvenilir" Binding="{Binding Trusted}" Width="*" />
                <DataGridTextColumn Header="Son görülme (UTC)" Binding="{Binding LastSeenUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#475467" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Seçileni kaldır" Command="{Binding RemoveDeviceCommand}" Padding="14,8" Margin="12,0,0,0" Background="White" Foreground="#B42318" BorderBrush="#FDA29B" />
        </DockPanel>
    </Grid>
</Window>
